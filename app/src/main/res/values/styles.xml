<resources>
    <style name="Theme.MediaLab" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#0B0E17</item>
        <item name="android:navigationBarColor">#0B0E17</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#80A8FF</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.MediaLab.Light" parent="android:style/Theme.Material.Light.NoActionBar">
